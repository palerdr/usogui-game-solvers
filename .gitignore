# Python caches / build artifacts
__pycache__/
*.py[cod]
*.so
target/
/build/

# Virtualenvs / local tooling
.venv/
.python-version
.tools/
.vscode/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated reports and experiment outputs
outputs/
graphify-out/
multirun/
logs/
demos/
tmp/
paper/build/
paper/*.log
paper/*.synctex.gz
paper/*.aux
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
# Built tables: artifacts/dth/V.npy from python -m stl.dth_kernel and
# artifacts/leap from python -m stl.leap.
artifacts/

# Training artifacts
models/
checkpoints/
src/stl/checkpoints/

# Lean/Lake build products and the vendored Mathlib checkout
src/formal/.lake/
src/formal/build/

# Imported OCaml/Dune build products
src/dth_ocaml/_build/
src/dth_ocaml/_opam/
src/dth_ocaml/_coverage/
src/dth_ocaml/bisect*.coverage

# Generated media
*.png
# The character frames the web client draws are committed source art. Without
# them a fresh clone draws labelled placeholders and no test fails. The second
# line covers the client's later home in web/.
!src/browser/webclient/public/art/**/*.png
!web/public/art/**/*.png

# Browser app: client dependencies and build, and the Vercel bundle. The
# unanchored outputs/ and .vercel patterns cover src/browser/outputs/ and the
# project link in src/browser/.vercel/.
src/browser/webclient/node_modules/
src/browser/webclient/dist/
src/browser/build/

# OS/editor noise
.DS_Store
Thumbs.db

# Local AI/tooling metadata
/.codex
/.agents
.vercel
.env*
